# ==============================================================================
# AI Outbound Voice Agent - Environment Configuration
# ==============================================================================

# Application & Network
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
# The public domain/hostname exposed by ngrok or reverse proxy (e.g., abc123.ngrok-free.app)
# DO NOT include http:// or wss:// prefix
PUBLIC_HOST=localhost:8000
API_KEY=visitsly_secret_booking_key_2026
ADMIN_API_KEY=visitsly_admin_secret_key_2026
COMPANY_NAME=Visitsly
TIMEZONE=Asia/Kolkata

# Database (PostgreSQL recommended; SQLite supported for zero-setup local test)
# For Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/voice_agent_db
# For SQLite: sqlite+aiosqlite:///./voice_agent.db
DATABASE_URL=sqlite+aiosqlite:///./voice_agent.db

# Plivo Telephony Credentials
# Sign up at https://console.plivo.com
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
# Registered Plivo phone number in E.164 format (e.g., +919876543210 or US +1...)
PLIVO_CALLER_ID=+918047289335
PLIVO_CPS=1.0
PLIVO_ANSWER_METHOD=POST
PLIVO_HANGUP_METHOD=POST

# Calling Window & Retry Policies
CALLING_WINDOW_START_HOUR=9
CALLING_WINDOW_END_HOUR=21
MAX_RETRY_ATTEMPTS=2
RETRY_MIN_INTERVAL_HOURS=2
MAX_CALL_DURATION_SECONDS=180
SILENCE_TIMEOUT_SECONDS=6
MAX_SILENCE_PROMPTS=2

# SaaS Outbound Result Webhook
# Visitsly-Backend or custom CRM URL that receives call outcomes
SAAS_WEBHOOK_URL=https://ai-realstate-agent.onrender.com/api/webhooks/voice/result
SAAS_WEBHOOK_SECRET=visitsly_webhook_hmac_secret_key_32chars

# ==============================================================================
# Providers Selection
# ==============================================================================

# LLM Provider: 'groq' (Free & fast), 'gemini' (Free), 'claude' (Anthropic), 'mock'
LLM_PROVIDER=groq
# Groq LLM (Recommended for free, <300ms latency)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# STT Provider: 'deepgram', 'groq', 'sarvam', 'mock'
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=hi
# Sarvam STT (Optional alternative)
SARVAM_API_KEY=your_sarvam_api_key

# TTS Provider: 'edge_tts' (100% Free, zero quota limits), 'sarvam', 'elevenlabs', 'mock'
TTS_PROVIDER=edge_tts
# Edge-TTS voice options: hi-IN-SwaraNeural (Female), hi-IN-MadhurNeural (Male)
EDGE_TTS_VOICE=hi-IN-SwaraNeural
# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_MODEL=eleven_flash_v2_5
# Sarvam TTS
SARVAM_TTS_VOICE=meera
